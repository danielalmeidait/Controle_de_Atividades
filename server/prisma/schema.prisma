// --- DATABASE SAFETY LOCK ---
// AVISO: NUNCA realize migrações que resultem em PERDA DE DADOS (reset) sem autorização.
// SEMPRE verifique se a mudança exige o comando 'migrate dev' com reset do SQLite.
// ----------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id             Int       @id @default(autoincrement())
  name           String
  type           String
  area           String
  system         String
  requester      String
  criticality    String
  status         String
  deadline       DateTime? // nullable: nem toda tarefa tem prazo
  requestDate    DateTime
  requestingArea String    @default("")
  checklist      String    // JSON string
  lastUpdate     String
  updateHistory  String    @default("[]") // JSON string [{date, text}]
  description    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Area {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model System {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model TaskType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model TaskStatus {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Idea {
  id            Int      @id @default(autoincrement())
  title         String
  content       String
  reviewDate    String?
  relatedTaskId Int?
  relatedSystem String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
