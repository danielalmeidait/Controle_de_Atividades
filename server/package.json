{
    "name": "activities-control-server",
    "version": "1.0.0",
    "description": "Backend for Activities_Control dashboard",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:seed": "ts-node prisma/seed.ts",
        "backup:full": "ts-node scripts/backup.ts --type full",
        "backup:incremental": "ts-node scripts/backup.ts --type incremental"
    },
    "prisma": {
        "seed": "npx ts-node prisma/seed.ts"
    },
    "dependencies": {
        "express": "^4.18.2",
        "cors": "^2.8.5",
        "@prisma/client": "^5.10.2"
    },
    "devDependencies": {
        "typescript": "^5.3.3",
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.19",
        "@types/cors": "^2.8.17",
        "prisma": "^5.10.2",
        "ts-node-dev": "^2.0.0"
    }
}